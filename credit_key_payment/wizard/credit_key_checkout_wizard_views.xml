<?xml version="1.0"?>
<odoo>
    <record id="view_credit_key_checkout_wizard_form" model="ir.ui.view">
        <field name="name">credit.key.checkout.wizard.form</field>
        <field name="model">credit.key.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Key Checkout">
                <header>
                        <span>adsadsad a</span>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ck_borrower_name" readonly="1"/>
                            <field name="ck_borrower_email" readonly="1"/>
                        </group>
                        <group>
                            <field name="ck_company_name" readonly="1"/>
                            <field name="ck_status" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Company Details">
                            <group>
                                <field name="ck_company_name" readonly="1"/>
                                <field name="ck_status" readonly="1"/>
                                <field name="ck_tcl_amount" readonly="1"/>
                                <field name="ck_tcl_remaining" readonly="1"/>
                            </group>
                        </page>
                        <page string="Support">
                            <group>
                                <field name="support_link" widget="url" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <div>
                        <div class="mb-1">
                            <strong invisible="not context.get('show_footer_message')">Would you like to authorize payment with the customer's default term?</strong>
                        </div>
                        <div>
                            <button name="action_confirm" string="Authorize" type="object" class="btn-primary mr-2" invisible="not credit_key_company_id"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </div>
                    </div>
                </footer>
            </form>
        </field>
    </record>
</odoo>

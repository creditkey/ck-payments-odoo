<?xml version="1.0"?>
<odoo>
    <record id="credit_key_checkout_wizard_view_form" model="ir.ui.view">
        <field name="name">credit.key.checkout.wizard.view.form</field>
        <field name="model">credit.key.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay with Credit Key">
                <group>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="partner_name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="credit_key_company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="street"/>
                        <field name="street2"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="zip"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="not credit_key_company_id"/>
                    <button name="credit_key_check_company" string="Check Company" type="object" invisible="credit_key_company_id"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

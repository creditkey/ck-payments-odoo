<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.credit.key</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <button name="credit_key_checkout" string="Credit Key" type="object" invisible="state != 'posted'"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Credit Key">
                    <group>
                        <field name="credit_key_order_id" readonly="1"/>
                        <field name="credit_key_status" readonly="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.credit.key</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group name="v1_keys" string="V1 Keys" invisible="code != 'credit_key'">
                    <field
                        name="credit_key_public_key"
                        required="code == 'credit_key' and state != 'disabled'"
                        password="True"/>
                    <field
                        name="credit_key_shared_secret"
                        required="code == 'credit_key' and state != 'disabled'"
                        password="True"/>
                </group>
                <group name="v2_keys" string="V2 Keys" invisible="code != 'credit_key'">
                    <field
                        name="credit_key_client_key"
                        required="code == 'credit_key' and state != 'disabled'"
                        password="True"/>
                    <field
                        name="credit_key_client_secret"
                        required="code == 'credit_key' and state != 'disabled'"
                        password="True"/>
                </group>
            </group>
            <group name="payment_followup" position="after">
                <group
                    name="show_promotional_product"
                    string="Product Promotional Message"
                    invisible="code != 'credit_key'">
                    <field name="show_promotional_message_product"/>
                    <field name="custom_location_selector_product"/>
                </group>
                <group name="show_promotional_cart" string="Cart Promotional Message" invisible="code != 'credit_key'">
                    <field name="show_promotional_message_cart"/>
                    <field name="custom_location_selector_cart"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
